<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.inventory.mapper.InvTransferShipmentMapper">

    <resultMap type="InvTransferShipment" id="InvTransferShipmentResult">
        <id property="shipmentId" column="shipment_id"/>
        <result property="transferId" column="transfer_id"/>
        <result property="shipmentNo" column="shipment_no"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseDeptId" column="warehouse_dept_id"/>
        <result property="sourceLocationDeptId" column="source_location_dept_id"/>
        <result property="inventoryWriteVersion" column="inventory_write_version"/>
        <result property="commandRequestId" column="command_request_id"/>
        <result property="planVersion" column="plan_version"/>
        <result property="sealedRevisionId" column="sealed_revision_id"/>
        <result property="reconcileBatch" column="reconcile_batch"/>
        <result property="status" column="status"/>
        <result property="shippedBy" column="shipped_by"/>
        <result property="shippedTime" column="shipped_time"/>
        <result property="receivedBy" column="received_by"/>
        <result property="receivedTime" column="received_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectInvTransferShipmentVo">
        select shipment_id, transfer_id, shipment_no, warehouse_id, warehouse_dept_id,
               source_location_dept_id,
               inventory_write_version, command_request_id, plan_version,
               sealed_revision_id, reconcile_batch,
               status, shipped_by, shipped_time, received_by, received_time,
               create_by, create_time, update_by, update_time, remark
        from inv_transfer_shipment
    </sql>

    <select id="selectById" parameterType="Long" resultMap="InvTransferShipmentResult">
        <include refid="selectInvTransferShipmentVo"/>
        where shipment_id = #{shipmentId}
    </select>

    <select id="selectByIdForUpdate" parameterType="Long" resultMap="InvTransferShipmentResult">
        <include refid="selectInvTransferShipmentVo"/>
        where shipment_id = #{shipmentId} for update
    </select>

    <select id="selectByTransferId" parameterType="Long" resultMap="InvTransferShipmentResult">
        <include refid="selectInvTransferShipmentVo"/>
        where transfer_id = #{transferId}
        order by shipped_time asc, shipment_id asc
    </select>

    <select id="selectByIds" resultMap="InvTransferShipmentResult">
        <include refid="selectInvTransferShipmentVo"/>
        where shipment_id in
        <foreach collection="shipmentIds" item="shipmentId" open="(" close=")" separator=",">
            #{shipmentId}
        </foreach>
    </select>

    <insert id="insertShipment" parameterType="InvTransferShipment" useGeneratedKeys="true" keyProperty="shipmentId">
        insert into inv_transfer_shipment (
            transfer_id, shipment_no, warehouse_id, warehouse_dept_id,
            source_location_dept_id, inventory_write_version,
            command_request_id, plan_version, sealed_revision_id,
            reconcile_batch, status,
            shipped_by, shipped_time, received_by, received_time, create_by, create_time, remark
        ) values (
            #{transferId}, #{shipmentNo}, #{warehouseId}, #{warehouseDeptId},
            #{sourceLocationDeptId},
            coalesce(#{inventoryWriteVersion}, 'LEGACY'),
            #{commandRequestId}, #{planVersion}, #{sealedRevisionId},
            #{reconcileBatch}, #{status},
            #{shippedBy}, #{shippedTime}, #{receivedBy}, #{receivedTime}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateShipment" parameterType="InvTransferShipment">
        update inv_transfer_shipment
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="receivedBy != null">received_by = #{receivedBy},</if>
            <if test="receivedTime != null">received_time = #{receivedTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy}, update_time = sysdate()
        </set>
        where shipment_id = #{shipmentId}
    </update>

</mapper>
