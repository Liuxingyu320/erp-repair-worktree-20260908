<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.system.mapper.SysUserSalarySchemeMapper">

    <resultMap id="SysUserSalarySchemeResult" type="SysUserSalaryScheme">
        <id     property="relationId"   column="relation_id"    />
        <result property="userId"       column="user_id"        />
        <result property="shopDeptId"   column="shop_dept_id"   />
        <result property="schemeId"     column="scheme_id"      />
        <result property="itemId"       column="item_id"        />
        <result property="priority"     column="priority"       />
        <result property="effectiveDate" column="effective_date"/>
        <result property="endDate"      column="end_date"       />
        <result property="status"       column="status"         />
        <result property="userName"     column="user_name"      />
        <result property="nickName"     column="nick_name"      />
        <result property="deptId"       column="dept_id"        />
        <result property="deptName"     column="dept_name"      />
        <result property="shopDeptName" column="shop_dept_name" />
        <result property="schemeName"   column="scheme_name"    />
        <result property="socialType"   column="social_type"    />
        <result property="postName"     column="post_name"      />
        <result property="gradeName"    column="grade_name"     />
        <result property="regionName"   column="region_name"    />
        <result property="totalSalary"  column="total_salary"   />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>

    <sql id="selectUserSalarySchemeVo">
        select us.relation_id,
               us.user_id,
               us.shop_dept_id,
               us.scheme_id,
               us.item_id,
               us.priority,
               us.effective_date,
               us.end_date,
               us.status,
               us.create_by,
               us.create_time,
               us.update_by,
               us.update_time,
               us.remark,
               u.user_name,
               u.nick_name,
               u.dept_id,
               dept.dept_name,
               shop.dept_name as shop_dept_name,
               s.scheme_name,
               s.social_type,
               i.post_name,
               i.grade_name,
               i.region_name,
               i.total_salary
        from sys_user_salary_scheme us
             left join sys_user u on u.user_id = us.user_id
             left join sys_dept dept on dept.dept_id = u.dept_id
             left join sys_dept shop on shop.dept_id = us.shop_dept_id
             left join sys_salary_scheme s on s.scheme_id = us.scheme_id
             left join sys_salary_scheme_item i on i.item_id = us.item_id
    </sql>

    <select id="selectUserSalarySchemesByUserId" parameterType="Long" resultMap="SysUserSalarySchemeResult">
        <include refid="selectUserSalarySchemeVo"/>
        where us.user_id = #{userId}
        order by us.priority desc, us.effective_date desc, us.relation_id asc
    </select>

    <select id="selectUserSalarySchemesByUserIds" resultMap="SysUserSalarySchemeResult">
        <include refid="selectUserSalarySchemeVo"/>
        where us.user_id in
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        order by us.user_id asc, us.priority desc, us.effective_date desc, us.relation_id asc
    </select>

    <delete id="deleteUserSalarySchemeByUserId" parameterType="Long">
        delete from sys_user_salary_scheme where user_id = #{userId}
    </delete>

    <delete id="deleteUserSalarySchemeBySchemeIds" parameterType="Long">
        delete from sys_user_salary_scheme where scheme_id in
        <foreach collection="array" item="schemeId" open="(" separator="," close=")">
            #{schemeId}
        </foreach>
    </delete>

    <insert id="batchUserSalaryScheme">
        insert into sys_user_salary_scheme (
            user_id,
            shop_dept_id,
            scheme_id,
            item_id,
            priority,
            effective_date,
            end_date,
            status,
            remark,
            create_by,
            create_time
        ) values
        <foreach collection="list" item="item" separator=",">
            (
                #{item.userId},
                #{item.shopDeptId},
                #{item.schemeId},
                #{item.itemId},
                #{item.priority},
                #{item.effectiveDate},
                #{item.endDate},
                #{item.status},
                #{item.remark},
                #{item.createBy},
                sysdate()
            )
        </foreach>
    </insert>
</mapper>
