# ERP-NEW_2-only browser-session settings.
# Copy to an ignored .env.local and generate a new value of at least 32 random
# bytes; never reuse the protected project's JWT, session, database, Redis, or
# Nacos secrets. The empty example intentionally fails closed if enabled as-is.
ERP_NEW_2_BROWSER_SESSION_ENABLED=false
ERP_NEW_2_BROWSER_SESSION_COOKIE_SECURE=true
ERP_NEW_2_BROWSER_SESSION_CSRF_SECRET=
