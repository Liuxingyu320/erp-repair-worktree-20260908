# 页面标题
VUE_APP_TITLE = 企业管理系统

BABEL_ENV = production

NODE_ENV = production

# 测试环境配置
ENV = 'staging'

# 企业管理系统/测试环境
VUE_APP_BASE_API = '/stage-api'

# Web 会话灰度开关：bearer|cookie。Capacitor Native 始终使用 Bearer。
VUE_APP_WEB_SESSION_MODE = bearer

# Excel 入职合同导入入口（长期保持开启；仍受登录与权限校验保护）
VUE_APP_SIGN_EXCEL_IMPORT_ENABLED = true

# 测试环境同时开放快捷与批量审批，供完整 UAT
VUE_APP_TODO_QUICK_APPROVE_ENABLED = true
VUE_APP_TODO_BATCH_APPROVE_ENABLED = true
