{
  "name": "erp-ui",
  "version": "3.6.8",
  "description": "ERP 管理系统",
  "author": "ERP",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vue-cli-service serve",
    "test": "node scripts/run-node-tests.cjs",
    "evidence:mobile-runtime": "node scripts/capture-mobile-runtime-evidence.cjs",
    "prebuild:prod": "node scripts/scan-frontend-secrets.cjs && node scripts/validate-release-build.cjs",
    "build:prod": "vue-cli-service build --report-json",
    "postbuild:prod": "node scripts/check-production-bundle.cjs && node scripts/write-release-info.cjs",
    "prebuild:onboard-contract": "node scripts/scan-frontend-secrets.cjs && node scripts/validate-release-build.cjs && node scripts/validate-onboard-release-build.cjs",
    "build:onboard-contract": "vue-cli-service build --report-json",
    "postbuild:onboard-contract": "node scripts/check-production-bundle.cjs && node scripts/write-release-info.cjs && node scripts/write-onboard-release-provenance.cjs",
    "build:stage": "vue-cli-service build --mode staging",
    "preview": "node build/index.js --preview",
    "postinstall": "patch-package",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org",
    "preapp:sync": "node scripts/validate-native-api-origin.cjs",
    "app:sync": "node scripts/harden-capacitor-native-config.cjs && npm run build:prod && NODE_ENV=production npx cap sync && node scripts/harden-capacitor-native-config.cjs && node scripts/verify-capacitor-sync.cjs",
    "app:open:ios": "npx cap open ios",
    "app:open:android": "npx cap open android",
    "app:package:android": "node scripts/build-native-packages.cjs --platform=android",
    "app:package:ios": "node scripts/build-native-packages.cjs --platform=ios",
    "app:verify": "node scripts/harden-capacitor-native-config.cjs && npm run test && node scripts/harden-capacitor-native-config.cjs && node scripts/verify-capacitor-sync.cjs",
    "postapp:verify": "node scripts/verify-capacitor-sync.cjs",
    "preapp:verify:release": "node scripts/validate-native-api-origin.cjs",
    "app:verify:release": "node scripts/harden-capacitor-native-config.cjs && npm run test && node scripts/harden-capacitor-native-config.cjs && node scripts/verify-capacitor-sync.cjs --release"
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://example.com"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "8.1.1",
    "@riophae/vue-treeselect": "0.4.0",
    "axios": "^1.18.1",
    "clipboard": "2.0.8",
    "core-js": "3.37.1",
    "dompurify": "3.4.13",
    "echarts": "6.1.0",
    "element-ui": "2.15.14",
    "file-saver": "2.0.5",
    "form-data": "^4.0.6",
    "fuse.js": "6.4.3",
    "js-beautify": "2.0.3",
    "js-cookie": "^3.0.8",
    "nprogress": "0.2.0",
    "qrcode-generator": "2.0.4",
    "quill": "2.0.2",
    "screenfull": "5.0.2",
    "sortablejs": "1.10.2",
    "vue": "2.6.12",
    "vue-count-to": "1.0.13",
    "vue-cropper": "0.5.5",
    "vue-router": "3.4.9",
    "vuedraggable": "2.24.3",
    "vuex": "3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@vue/cli-plugin-babel": "4.4.6",
    "@vue/cli-service": "4.4.6",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "chalk": "4.1.0",
    "compression-webpack-plugin": "6.1.2",
    "connect": "3.6.6",
    "patch-package": "8.0.1",
    "sass": "1.32.13",
    "sass-loader": "10.1.1",
    "script-ext-html-webpack-plugin": "2.1.5",
    "svg-sprite-loader": "5.1.1",
    "typescript": "^5.9.3",
    "vue-template-compiler": "2.6.12",
    "webpack": "^4.47.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
