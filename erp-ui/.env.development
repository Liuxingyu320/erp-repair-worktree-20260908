# 页面标题
VUE_APP_TITLE = 企业管理系统

# 开发环境配置
ENV = 'development'

# 企业管理系统/开发环境
VUE_APP_BASE_API = '/dev-api'

# 本地可在后端 local dual 模式就绪后临时切为 cookie 验证 Web Cookie 会话。
VUE_APP_WEB_SESSION_MODE = bearer

# Excel 入职合同导入入口（长期保持开启；仍受登录与权限校验保护）
VUE_APP_SIGN_EXCEL_IMPORT_ENABLED = true

# 统一待办审批增强（本地验证）
VUE_APP_TODO_QUICK_APPROVE_ENABLED = true
VUE_APP_TODO_BATCH_APPROVE_ENABLED = true

# 路由懒加载需要保留 import()，不要在开发模式把 ES modules 转成 CommonJS。
# 如需源码映射调试，可临时设置 VUE_APP_DEV_SOURCE_MAP = true
