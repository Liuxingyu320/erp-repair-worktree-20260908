# 页面标题
VUE_APP_TITLE = 企业管理系统

# 生产环境配置
ENV = 'production'

# 企业管理系统/生产环境
VUE_APP_BASE_API = '/prod-api'

# Web 会话灰度开关：生产默认 bearer；仅在后端 dual 与 CSRF/CORS 配置就绪后改为 cookie。
VUE_APP_WEB_SESSION_MODE = bearer

# Excel 入职合同导入入口（生产长期保持开启；仍受登录与权限校验保护）
VUE_APP_SIGN_EXCEL_IMPORT_ENABLED = true

# 生产第一阶段：开放快捷通过，批量通过完成一轮业务高峰观察后再开启
VUE_APP_TODO_QUICK_APPROVE_ENABLED = true
VUE_APP_TODO_BATCH_APPROVE_ENABLED = false
