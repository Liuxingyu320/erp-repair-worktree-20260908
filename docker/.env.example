# Copy to docker/.env and replace every value before starting the stack.
# Keep this file as a template only; do not commit real secrets.

NACOS_AUTH_TOKEN=replace-with-a-strong-random-token-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-a-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-random-identity-value
NACOS_DB_USER=nacos_app
NACOS_DB_PASSWORD=replace-with-the-nacos-database-password
NACOS_CLIENT_USERNAME=replace-with-the-production-nacos-client
NACOS_CLIENT_PASSWORD=replace-with-the-production-nacos-client-password
# ECS containers use host networking and require a Nacos process reachable on
# loopback before deployment. The read-only production preflight must verify it.
ECS_NACOS_SERVER_ADDR=127.0.0.1:8848
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
MYSQL_DATABASE=BossERP_NEW
MYSQL_USERNAME=erp_app
MYSQL_PASSWORD=replace-with-the-application-database-password
SPRING_PROFILES_ACTIVE=prod
ERP_JWT_SECRET=replace-with-a-strong-jwt-secret
REDIS_PASSWORD=replace-with-a-strong-redis-password
# Manual Excel onboarding stays enabled; authorization remains permission-scoped.
OA_SIGN_EXCEL_IMPORT_ENABLED=true
# Attendance reverse geocoding; configure privately before enabling the feature.
OA_ATTENDANCE_ADDRESS_PROVIDER=NONE
OA_ATTENDANCE_AMAP_WEB_SERVICE_KEY=
OA_ATTENDANCE_AMAP_CONNECT_TIMEOUT_MILLIS=1500
OA_ATTENDANCE_AMAP_READ_TIMEOUT_MILLIS=2500
OA_ATTENDANCE_AMAP_RADIUS_METERS=100
OA_ATTENDANCE_AMAP_MAX_RESPONSE_BYTES=131072
# Reimbursement OCR uses Baidu Cloud first when both keys are present, then
# automatically falls back to the container's local Chinese Tesseract engine.
OA_REIMBURSEMENT_OCR_CLOUD_ENABLED=true
OA_REIMBURSEMENT_OCR_LOCAL_ENABLED=true
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
HR_SIGN_LIFECYCLE_AUTOMATION_ENABLED=false
PROFILE_COMPLETION_GATE_ENABLED=true
APP_DATASOURCE_URL=jdbc:mysql://erp-mysql:3306/BossERP_NEW?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=false&serverTimezone=Asia/Shanghai
# Host-network deployments cannot resolve the Compose service name. Keep this
# URL loopback-only so the application database is never exposed externally.
ECS_APP_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/BossERP_NEW?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=false&serverTimezone=Asia/Shanghai
# Create and grant this application user in MySQL before starting module services.
APP_DATASOURCE_USERNAME=erp_app
APP_DATASOURCE_PASSWORD=replace-with-the-application-database-password
# One canonical host root for public uploads and every private file domain.
# Host-style services and Compose containers consume the same absolute /data
# paths, eliminating release-relative and container-only aliases.
ERP_UPLOAD_ROOT=/data/erp-new-data/uploadPath
FILE_PATH=/data/erp-new-data/uploadPath
SIGN_PACKAGE_STORAGE_ROOT=/data/erp-new-data/uploadPath/private/sign-package
OA_ATTENDANCE_STORAGE_ROOT=/data/erp-new-data/uploadPath/private/attendance
OA_REIMBURSEMENT_STORAGE_ROOT=/data/erp-new-data/uploadPath/private/reimbursement
DRIVE_LOCAL_PATH=/data/erp-new-data/uploadPath/private/drive
FILE_DOMAIN=https://replace-with-production-hostname/prod-api
REFERER_ENABLED=true
REFERER_ALLOWED_DOMAINS=replace-with-production-hostname

# Every production artifact and runtime must use the same immutable release
# identity. The release preflight rejects placeholders and mismatched values.
RELEASE_ID=replace-with-lowercase-release-id
GIT_COMMIT=replace-with-full-40-character-lowercase-git-sha
BUILD_TIME=replace-with-utc-iso-8601-timestamp

# Required before warehouse users maintain OE purchase references.
# Comma-separated host names only, for example: approved-shop.example.com,procurement.example.com
INVENTORY_OE_PURCHASE_REFERENCE_ALLOWED_HOSTS=

# Optional local port overrides. Internal services bind to 127.0.0.1 by default.
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
MYSQL_PORT=3306
REDIS_PORT=6379
NGINX_PORT=80
GATEWAY_PORT=8080
AUTH_PORT=9200
SYSTEM_PORT=9201
JOB_PORT=9203
OA_PORT=9204
INVENTORY_PORT=9205
APPROVAL_PORT=9206
FILE_PORT=9300
MONITOR_PORT=9100

# Host runtime storage contract (native systemd deployment; create and verify on /data first).
ERP_LOG_ROOT=/data/erp-new-data/logs
ERP_TEMP_ROOT=/data/erp-new-data/tmp
ERP_CACHE_ROOT=/data/erp-new-data/cache
SIGN_PACKAGE_TEMP_ROOT=/data/erp-new-data/uploadPath/private/sign-package-temp
OA_ATTENDANCE_TEMP_ROOT=/data/erp-new-data/tmp/attendance
OA_REIMBURSEMENT_TEMP_ROOT=/data/erp-new-data/tmp/reimbursement
# Engineering default: preserve image resolution; PNG lossless; do not enlarge files.
ERP_IMAGE_JPEG_QUALITY=0.92
ERP_IMAGE_PYTHON=/data/erp-new-runtime/image-codecs/bin/python
