      "body": {
        "requestId": "contract-uat-reissue-001", "action": "REISSUE",
        "documentVersion": "${faultFixtures.expiredDocumentVersion}",
        "reasonCode": "UAT_REISSUE", "reasonDetail": "Isolated UAT replacement verification",
        "expectedVersion": "${faultFixtures.expiredExpectedVersion}",
        "replacementPlanVersionId": "${faultFixtures.replacementPlanVersionId}"
      },
      "requiredKeys": ["code", "data"]
    },
    {
      "id": "notification-failure", "case": "notification-failure", "actor": "dedicatedHrOrgA", "organization": "orgA",
