    },
    {
      "id": "notification-recovery", "case": "notification-recovery", "actor": "dedicatedHrOrgA", "organization": "orgA",
      "method": "POST", "path": "/signTask/${faultFixtures.notificationTaskId}/notification/retry", "expect": "success",
      "writePurpose": "Requeue the deliberately failed UAT notification after dependency recovery",
      "body": { "requestId": "contract-uat-notify-retry-001", "businessKey": "${faultFixtures.notificationBusinessKey}" },
      "requiredKeys": ["code"]
    },
    {
      "id": "duplicate-request", "case": "duplicate-request", "actor": "dedicatedHrOrgA", "organization": "orgA",
      "method": "POST", "path": "/signTask/${faultFixtures.duplicateNotificationTaskId}/notification/retry", "expect": "success",
      "writePurpose": "Prove repeated request ids do not create duplicate notification rows",
      "parallelBodies": [
        { "requestId": "contract-uat-duplicate-001", "businessKey": "${faultFixtures.duplicateNotificationBusinessKey}" },
        { "requestId": "contract-uat-duplicate-001", "businessKey": "${faultFixtures.duplicateNotificationBusinessKey}" }
      ],
      "minSuccess": 1, "maxSuccess": 2,
      "parallelFailureAllowedHttpStatuses": [409, 429],
      "parallelFailureAllowedAppCodes": [500],
      "parallelFailureMessageIncludes": ["重复", "请勿重复", "处理中"],
      "parallelSuccessIdentityPath": "data.notificationId",
      "postconditionProbe": {
        "id": "duplicate-notification-postcondition",
        "actor": "dedicatedHrOrgA",
        "organization": "orgA",
        "method": "GET",
        "path": "/uat/contract-signing/notifications/by-business-key?businessKey=${faultFixtures.duplicateNotificationBusinessKey}",
