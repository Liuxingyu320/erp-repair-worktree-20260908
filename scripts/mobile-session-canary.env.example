# Copy these non-secret values into the release system or export them in the
# change window. Do not place passwords, tokens, private keys, or Cookie values
# in this file.

DEPLOY_ENV=staging
RELEASE_PHASE=web-cookie-canary

AUTH_SESSION_MODE=dual
GATEWAY_SESSION_MODE=dual
WEB_SESSION_MODE=cookie
AUTH_CONFIG_REVISION=CHANGE-ME
GATEWAY_CONFIG_REVISION=CHANGE-ME

COOKIE_NAME=ERP_SESSION
CSRF_COOKIE_NAME=XSRF-TOKEN
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
CSRF_COOKIE_HTTP_ONLY=false
COOKIE_SAME_SITE=Lax
CSRF_ENABLED=true
REQUIRE_ORIGIN=true

PUBLIC_ORIGIN=https://erp-staging.example.com
ALLOWED_ORIGINS=https://erp-staging.example.com
NATIVE_BEARER_ENABLED=true

# These four gates must be true before any non-local Cookie canary.
EFFECTIVE_CONFIG_SNAPSHOT_RECORDED=false
MULTI_ACCOUNT_UAT_PASSED=false
ROLLBACK_ARTIFACT_READY=false
MONITORING_READY=false
